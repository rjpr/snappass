#: snappass/templates/base.html:3 snappass/templates/base.html:5
msgid "en"
msgstr "fr"

#: snappass/templates/base.html:8
msgid "Snappass - Share Secrets"
msgstr "Snappass - Partagez vos secrets !"

#: snappass/templates/base.html:23
msgid "Share a secret"
msgstr "Partager un secret"

#: snappass/templates/base.html:25
msgid "View shared secret"
msgstr "Voir le secret partagé"

#: snappass/templates/confirm.html:5
msgid "Secret link created. Share this one-time use URL:"
msgstr "Lien de partage du secret créé. Partagez cette URL à usage unique :"

#: snappass/templates/confirm.html:9 snappass/templates/password.html:7
msgid "Copy to clipboard"
msgstr "Copier dans le presse-papier"

#: snappass/templates/confirm.html:15
msgid "Share Another Secret"
msgstr "Partager un autre secret"

#: snappass/templates/expired.html:6
msgid "The secret you're looking for is missing or has expired."
msgstr "Le secret que vous recherchez est manquant ou a expiré."

#: snappass/templates/password.html:12
msgid "Secret has been deleted. This link can't be used again."
msgstr "Le secret a été supprimé. Ce lien ne peut plus être utilisé."

#: snappass/templates/password.html:15
msgid "Share Your Own Secret"
msgstr "Partagez votre propre secret"

#: snappass/templates/preview.html:5
msgid "This secret will be permanently deleted after you view it."
msgstr "Ce secret sera définitivement supprimé après l'avoir consulté."

#: snappass/templates/preview.html:6
msgid "View Secret"
msgstr "Voir le secret"

#: snappass/templates/set_password.html:7
msgid "Your Secret"
msgstr "Votre secret"

#: snappass/templates/set_password.html:8
msgid "Enter sensitive data to share via an encrypted, one-time use link..."
msgstr ""
"Saisissez des données sensibles à partager via un lien crypté à usage "
"unique..."

#: snappass/templates/set_password.html:12
msgid "Expires In"
msgstr "Expire dans"

#: snappass/templates/set_password.html:15
msgid "1 hour"
msgstr "1 heure"

#: snappass/templates/set_password.html:16
msgid "8 hours"
msgstr "8 heures"

#: snappass/templates/set_password.html:17
msgid "1 day"
msgstr "1 jour"

#: snappass/templates/set_password.html:18
msgid "7 days"
msgstr "7 jours"

#: snappass/templates/set_password.html:19
msgid "14 days"
msgstr "14 jours"

#: snappass/templates/set_password.html:27
msgid "Create Secret Link"
msgstr "Créer un lien secret"

